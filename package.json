{
  "name": "logseq-plugin-telepathy-qr",
  "private": true,
  "version": "1.0.0",
  "description": "Export a Logseq page or a single bullet as a (sequence) of QR code(s) and scan it with another device. No cloud, no app, just seemingly telepathic transmission with light 📱📷⚡",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TobiObeck/logseq-plugin-telepathy-qr.git"
  },
  "type": "module",
  "logseq": {
    "id": "logseq-plugin-telepathy-qr",
    "title": "TelepathyQR",
    "icon": "./icon.svg",
    "main": "dist/index.html"
  },
  "scripts": {
    "dev": "vite --config ./.config/vite.config.ts",
    "build": "tsc -b ./.config/tsconfig.json && vite build --config ./.config/vite.config.ts",
    "lint": "oxlint",
    "test": "vitest run --config ./.config/vitest.config.ts",
    "preview": "vite --config ./.config/vite.config.ts preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@logseq/libs": "^0.2.3",
    "@xstate/store": "^4.3.0",
    "@xstate/store-react": "^2.1.0",
    "bulma": "^1.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "storybook": "10.6.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-logseq": "^1.1.2",
    "vitest": "^5.0.5"
  }
}
